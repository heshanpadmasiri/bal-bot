{
  "name": "bal-bot",
  "version": "1.0.0",
  "description": "",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "npm run dev --workspace @bal-bot/editor --",
    "build": "npm run build --workspace @bal-bot/editor",
    "preview": "npm run start --workspace @bal-bot/editor --",
    "test": "node --test packages/browser-workspace/tests/*.test.mjs packages/compiler/tests/*.test.mjs apps/editor/tests/*.test.mjs",
    "start": "npm run start --workspace @bal-bot/editor --",
    "test:compiler": "cd packages/compiler && GOWORK=off go test ./...",
    "test:flow-parity": "node scripts/capture_flow_baselines.mjs --verify",
    "review:flow": "node scripts/flow-review/server.mjs",
    "test:browser": "python3 scripts/build_compiler.py && playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "sirv": "^3.0.2"
  }
}
